# Copy to .env and fill in. Never commit the real .env.
# AI calls go through Portkey.
PORTKEY_API_KEY=your-portkey-api-key

# Model tiers, cheapest/fastest to smartest. Each chat turn starts on the fast tier and falls back up a tier on errors.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_SMART=gpt-6-astra

# Optional
# CATALOGUE_TTL=300            # seconds to cache catalogue rows (inventory is never cached)
# CHAT_TURNS_PER_IP_MIN=8      # chat rate limits
# CHAT_TURNS_PER_IP_DAY=150
# CHAT_TURNS_PER_DAY=2000
# TRUST_PROXY=0                # set to 1 only behind a trusted proxy that sets X-Forwarded-For
